# Expo loads this when you run `npx expo start` (restart Metro after edits).
# Without this file, the app still runs using defaults in lib/auth-client.ts:
#   Web: http://<browser-hostname>:4000
#   iOS simulator: http://localhost:4000
#   Android emulator: http://10.0.2.2:4000
# Physical device: use your computer's LAN IP, e.g. http://192.168.1.42:4000

EXPO_PUBLIC_API_URL=http://localhost:4000

# Optional — see .env.example
# EXPO_PUBLIC_PASSWORD_RESET_REDIRECT=
