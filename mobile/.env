# Expo loads this when you run `npx expo start` (restart Metro after edits).

EXPO_PUBLIC_API_URL=http://localhost:4000

# Physical phone (Expo Go QR): localhost is the phone itself → "Network request failed".
# Use your PC's LAN IP (same Wi‑Fi). Find it: Windows `ipconfig` → IPv4 (example below).
# EXPO_PUBLIC_API_URL=http://192.168.1.2:4000
#
# iOS Simulator: http://localhost:4000
# Android emulator: http://10.0.2.2:4000

# Optional — password reset redirect override.
# EXPO_PUBLIC_PASSWORD_RESET_REDIRECT=https://api.yourdomain.com/reset-mobile-bridge

# Optional — email verification redirect after /auth/verify-email (HTTPS native builds).
# If unset, native builds use ${EXPO_PUBLIC_API_URL}/verify-email-mobile-bridge when API URL is https.
# EXPO_PUBLIC_VERIFY_EMAIL_REDIRECT=https://api.yourdomain.com/verify-email-mobile-bridge

# When testing login from a real device, set backend BETTER_AUTH_URL to the same URL as above
# (e.g. http://192.168.1.2:4000). If it still fails, allow inbound TCP 4000 in Windows Firewall.
