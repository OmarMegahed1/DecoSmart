# Copy to `.env` in this folder (Expo loads it on `expo start`). `.env` is gitignored.
# If you skip `.env`, `lib/auth-client.ts` still picks a default (localhost, 10.0.2.2, or web host).
#
# Backend base URL (no trailing path). Must match backend BETTER_AUTH_URL in production.
# Physical phone/tablet: use your dev machine LAN IP, e.g. http://192.168.1.42:4000 (not localhost).
EXPO_PUBLIC_API_URL=http://localhost:4000

# Optional: Better Auth redirect after "forgot password" email (HTTPS). Overrides auto bridge below.
# Use the backend bridge so mail clients open https first, then the app: https://api.yourdomain.com/reset-mobile-bridge
# Or a universal link that maps to /reset-password in the app.
# EXPO_PUBLIC_PASSWORD_RESET_REDIRECT=https://api.yourdomain.com/reset-mobile-bridge

# When EXPO_PUBLIC_API_URL is https://..., native builds default redirectTo to ${EXPO_PUBLIC_API_URL}/reset-mobile-bridge
# (HTTPS first, then opens the app). Web ("expo start --web") always uses an in-browser /reset-password URL instead.
# Ensure backend AUTH_TRUSTED_ORIGINS or CORS_ORIGINS includes your deployed web origin (e.g. https://app.example.com).
# Optional: redirect after /auth/verify-email (HTTPS native builds). Defaults to ${EXPO_PUBLIC_API_URL}/verify-email-mobile-bridge when API URL is https.
# EXPO_PUBLIC_VERIFY_EMAIL_REDIRECT=https://api.yourdomain.com/verify-email-mobile-bridge
