# Backend environment — copy to `.env` and fill in.
# AI stack: Kaggle notebook (DXF + room renders) + WorldLabs Marble (3D worlds).
# The Express app does not run Stable Diffusion or Hugging Face Inference.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host.neon.tech/decor-ai?sslmode=require
# Local Postgres without TLS: use DATABASE_SSL=false (see db/client.ts)
# DATABASE_SSL=false
# Slow or cold serverless DB: raise pool connect timeout (ms)
# DATABASE_POOL_CONNECTION_TIMEOUT_MS=30000

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Comma-separated origins for CORS (Expo web, Metro, etc.)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081,http://localhost:8082
# Optional: extra Better Auth trusted origins (e.g. decor-ai-staging://), comma-separated.
# decor-ai:// and dev exp:// entries are added automatically in development.
# AUTH_TRUSTED_ORIGINS=

# ── WorldLabs Marble API ──────────────────────────────────────────────────────
WORLDLABS_API_KEY=

# ── Kaggle CAD pipeline (Flask + ngrok URL from notebook) ─────────────────────
CAD_PIPELINE_URL=
CAD_PIPELINE_TIMEOUT_MS=180000

# ── Upload (optional) ─────────────────────────────────────────────────────────
# Max images per POST /api/upload (1–4; default 4 — same cap as /api/generate)
# UPLOAD_MAX_VARIANTS=4

# ── Better Auth ───────────────────────────────────────────────────────────────
# BETTER_AUTH_SECRET: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public base URL of this API (no trailing slash). MUST match what clients use:
# same origin:port as mobile EXPO_PUBLIC_API_URL and web app API origin.
# Development: http://localhost:4000 (or http://YOUR_LAN_IP:4000 for a physical device).
# Production: https://api.yourdomain.com
BETTER_AUTH_URL=http://localhost:4000

# ── Resend (required in production for password-reset email delivery) ───────────
# https://resend.com — verify your sending domain; free tier includes onboarding@resend.dev for tests.
RESEND_API_KEY=
# Example production: "Decor AI <noreply@yourdomain.com>" (domain must be verified in Resend).
# Testing without your own domain — use Resend’s shared sender (do not use fake domains like yourverifieddomain.com):
# RESEND_FROM=Decor AI <onboarding@resend.dev>
RESEND_FROM=

# Custom app scheme in password-reset bridge page (default: decor-ai). Match mobile app.json `expo.scheme`.
# MOBILE_APP_SCHEME=decor-ai

# ── OAuth (optional — not wired in code until you add social providers) ───────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
