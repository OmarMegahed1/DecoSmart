# Backend environment (local). Do not commit — see `.env.example` for template.
# AI: Kaggle (CAD pipeline) + WorldLabs (3D). No SD/HF in this service.

# ── Database ──────────────────────────────────────────────────────────────────
# URL must keep sslmode=require for Neon. Do not set DATABASE_SSL=false here.
# Pool options are read by backend/src/db/client.ts (TLS + connect timeout).
DATABASE_URL=postgresql://neondb_owner:npg_7NkAjgb5BUtT@ep-divine-wind-abbig4n5-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_POOL_CONNECTION_TIMEOUT_MS=30000

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081,http://localhost:8082

# ── WorldLabs Marble API ──────────────────────────────────────────────────────
WORLDLABS_API_KEY=7swa2jGmb0uNevOJMDKmjxqhIDnwekVl

# ── Kaggle CAD pipeline (Flask + ngrok URL from notebook) ─────────────────────
CAD_PIPELINE_URL=https://verbally-bony-driving.ngrok-free.dev
CAD_PIPELINE_TIMEOUT_MS=180000

# ── Upload (optional) ─────────────────────────────────────────────────────────
# UPLOAD_MAX_VARIANTS=4

# ── Better Auth ───────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=your-super-secret-key-change-this-in-production
# Production: set to your public API URL (must match client EXPO_PUBLIC_API_URL), e.g. https://api.yourdomain.com
BETTER_AUTH_URL=http://localhost:4000

# ── Resend (production: set RESEND_API_KEY + verified RESEND_FROM; locally omit to log reset URLs) ──
RESEND_API_KEY=re_DjgEFFdS_LiKq1DeNERYMSAam3k81kmUN
# Until you verify a domain at resend.com/domains, use onboarding@resend.dev (not a placeholder domain).
RESEND_FROM=Decor AI <onboarding@resend.dev>
MOBILE_APP_SCHEME=decor-ai

# ── OAuth (optional) ──────────────────────────────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
