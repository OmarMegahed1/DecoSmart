# Backend Environment Variables
# Copy this to .env and fill in your values

# ── Database ──────────────────────────────────────────────────────────────────
# Get this from https://neon.tech → your project → Connection String
DATABASE_URL=postgresql://neondb_owner:npg_7NkAjgb5BUtT@ep-divine-wind-abbig4n5-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# Allowed origins for CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081,http://localhost:8082

# ── WorldLabs API ─────────────────────────────────────────────────────────────
WORLDLABS_API_KEY=qY4ciwDNDIjBxmSAYnw2BuxdmIOgeq2K

# ── Stable Diffusion + ControlNet (CAD enhancement) ─────────────────────────
# Set to true to run CAD PNG enhancement before WorldLabs upload
SD_CONTROLNET_ENABLED=true
SD_PROVIDER=hf_space

# Your SD/ControlNet service base URL
# For built-in backend proxy route, use: http://localhost:4000/api/sd
SD_CONTROLNET_API_URL=http://localhost:4000/api/sd

# Optional bearer token for SD service
SD_CONTROLNET_API_KEY=

# Model + ControlNet settings
SD_CONTROLNET_MODEL=sdxl
SD_CONTROLNET_TYPE=lineart
SD_CONTROLNET_STEPS=28
SD_CONTROLNET_CFG_SCALE=6.5
SD_CONTROLNET_STRENGTH=0.6
SD_CONTROLNET_ANGLE_VARIANTS=3
SD_CONTROLNET_MAX_UPLOAD_VARIANTS=3

# Prompt defaults used when enhance_prompt isn't provided
SD_CONTROLNET_DEFAULT_PROMPT=Architectural interior render from CAD floor plan, realistic perspective, clean walls and openings, balanced daylight, high detail
SD_CONTROLNET_DEFAULT_NEGATIVE_PROMPT=distorted geometry, warped walls, upside down view, blurry, noisy text overlays, watermark

# If true, generation continues with original image if SD step fails
SD_CONTROLNET_FAIL_OPEN=false

# If true, CAD mode rejects upload unless SD/ControlNet enhancement succeeds
SD_CONTROLNET_REQUIRE_FOR_CAD=true

# ── Hugging Face (used by /api/sd/enhance-cad proxy) ───────────────────────
HF_API_KEY=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
HF_MODEL_ID=lllyasviel/sd-controlnet-depth
HF_MODEL_CANDIDATES=lllyasviel/sd-controlnet-depth,stabilityai/stable-diffusion-xl-base-1.0,stabilityai/stable-diffusion-2-1
HF_PROVIDER_CANDIDATES=hf-inference
HF_BASE_URL=https://router.huggingface.co/hf-inference/models
HF_FALLBACK_MODEL_ID=lllyasviel/sd-controlnet-depth
HF_FALLBACK_BASE_URL=https://router.huggingface.co/hf-inference/models
HF_ALLOW_TEXT_TO_IMAGE_FALLBACK=false

# ── Hugging Face Space (Gradio API) ──────────────────────────────────────────
HF_SPACE_API_URL=https://hysts-controlnet-v1-1.hf.space
HF_SPACE_TIMEOUT_MS=90000
HF_SPACE_BEARER_TOKEN=

# ── Better Auth ───────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-super-secret-key-change-this-in-production
BETTER_AUTH_URL=http://localhost:4000

# ── OAuth (optional) ─────────────────────────────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
